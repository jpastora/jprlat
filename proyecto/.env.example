# EmailJS — configuración del formulario de contacto
# Copia este archivo como .env y completa los valores desde https://www.emailjs.com
# El prefijo VITE_ es obligatorio para que Vite exponga la variable al cliente.
# Si faltan estas variables, el formulario funciona en "modo demo" sin romper la app.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
